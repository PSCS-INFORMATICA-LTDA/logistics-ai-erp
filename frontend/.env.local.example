NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL pública do app (QR Code e link da proposta enviados ao cliente)
NEXT_PUBLIC_APP_URL=https://grx-management.vercel.app

# Teste Aceitar/Recusar no celular (mesma Wi-Fi) — IP do npm run dev (Network)
NEXT_PUBLIC_DEV_PUBLIC_URL=http://192.168.15.16:3002

# OCR da CNH (opcional — melhora precisão; sem isso usa Tesseract local)
GOOGLE_VISION_API_KEY=your-google-vision-api-key

# Pedágios automáticos na rota A→B (QualP Pro — https://qualp.com.br/pro/)
QUALP_API_TOKEN=your-qualp-access-token

# Piso ANTT todos os tipos de carga (opcional)
CIOT_ONLINE_API_TOKEN=ciot_your-token

# Mensalidade cartão (Asaas) — sandbox para teste do Felipe; production depois
# https://sandbox.asaas.com / https://www.asaas.com
ASAAS_API_KEY=your-asaas-api-key
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=your-random-webhook-token

# Service role (webhook de cobrança atualizar status sem login do usuário)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PSCS One SSO (DEV/Preview only). Names only. Never commit values.
# Do not enable against production Supabase tqeenmswotxqainkyyct.
PSCS_ONE_SSO_ENABLED=
PSCS_ONE_TOKEN_URL=
PSCS_ONE_CLIENT_ID=
PSCS_ONE_CLIENT_SECRET=
PSCS_ONE_REDIRECT_URI=

# PSCS One Core AR consumer (server-side). Names only — never commit values.
# Core HTTP base (DEV uses pscs-core.vercel.app against Core DEV Supabase).
PSCS_ONE_CORE_API_BASE_URL=
# Optional override; default derives from ONE_SUPABASE_URL / PSCS_ONE_SUPABASE_URL server env.
PSCS_ONE_CORE_SUPABASE_PROJECT_REF=
